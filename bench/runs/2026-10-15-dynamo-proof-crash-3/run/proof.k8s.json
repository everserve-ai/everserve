{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "nvidia.com/v1beta1",
      "kind": "DynamoGraphDeployment",
      "metadata": {
        "name": "proof",
        "namespace": "serving"
      },
      "spec": {
        "backendFramework": "vllm",
        "components": [
          {
            "name": "Frontend",
            "type": "frontend",
            "replicas": 1,
            "podTemplate": {
              "spec": {
                "containers": [
                  {
                    "name": "main",
                    "image": "cr.eu-north1.nebius.cloud/<registry>/everserve-engine:dev-e56d9bd"
                  }
                ],
                "imagePullSecrets": [
                  {
                    "name": "nebius-cr"
                  }
                ]
              }
            },
            "runtimeVersionOverride": "1.6.0"
          },
          {
            "name": "head",
            "type": "worker",
            "replicas": 1,
            "podTemplate": {
              "spec": {
                "securityContext": {
                  "runAsNonRoot": true,
                  "supplementalGroups": [
                    64000
                  ],
                  "runAsUser": 1000
                },
                "containers": [
                  {
                    "name": "main",
                    "image": "cr.eu-north1.nebius.cloud/<registry>/everserve-engine:dev-e56d9bd",
                    "command": [
                      "/bin/sh",
                      "-c",
                      "exec python3 -m dynamo.vllm \"$@\" $(python3 -m everserve_vllm.flags --head)",
                      "dynamo.vllm"
                    ],
                    "args": [
                      "--model",
                      "Qwen/Qwen2.5-0.5B-Instruct",
                      "--tensor-parallel-size",
                      "1",
                      "--pipeline-parallel-size",
                      "2",
                      "--max-model-len",
                      "8192",
                      "--gpu-memory-utilization",
                      "0.8",
                      "--num-gpu-blocks-override",
                      "4096",
                      "--block-size",
                      "16",
                      "--additional-config",
                      "{\"consolidator_endpoints\":null}",
                      "--nnodes",
                      "2",
                      "--node-rank",
                      "0",
                      "--master-addr",
                      "proof-rendezvous.serving.svc",
                      "--master-port",
                      "29500"
                    ],
                    "env": [
                      {
                        "name": "EVERSERVE_GRAPH_SAFE",
                        "value": "1"
                      },
                      {
                        "name": "EVERSERVE_ENGINE",
                        "value": "proof"
                      },
                      {
                        "name": "EVERSERVE_GUARANTEE",
                        "value": "continuous"
                      },
                      {
                        "name": "EVERSERVE_DAEMON_SOCKET",
                        "value": "/run/everserve/node.sock"
                      },
                      {
                        "name": "EVERSERVE_SHM_DIR",
                        "value": "/dev/shm/everserve"
                      },
                      {
                        "name": "VLLM_CACHE_ROOT",
                        "value": "/var/lib/everserve/vllm-cache"
                      },
                      {
                        "name": "EVERSERVE_HOST_IP",
                        "valueFrom": {
                          "fieldRef": {
                            "fieldPath": "status.podIP"
                          }
                        }
                      },
                      {
                        "name": "EVERSERVE_NODE",
                        "valueFrom": {
                          "fieldRef": {
                            "fieldPath": "spec.nodeName"
                          }
                        }
                      }
                    ],
                    "volumeMounts": [
                      {
                        "name": "everserve-daemon",
                        "mountPath": "/run/everserve"
                      },
                      {
                        "name": "everserve-shm",
                        "mountPath": "/dev/shm/everserve"
                      },
                      {
                        "name": "everserve-compile-cache",
                        "mountPath": "/var/lib/everserve/vllm-cache"
                      }
                    ],
                    "resources": {
                      "limits": {
                        "nvidia.com/gpu": "1"
                      }
                    }
                  }
                ],
                "volumes": [
                  {
                    "name": "everserve-daemon",
                    "hostPath": {
                      "path": "/run/everserve",
                      "type": "Directory"
                    }
                  },
                  {
                    "name": "everserve-shm",
                    "hostPath": {
                      "path": "/dev/shm/everserve",
                      "type": "Directory"
                    }
                  },
                  {
                    "name": "everserve-compile-cache",
                    "hostPath": {
                      "path": "/var/lib/everserve/vllm-cache",
                      "type": "Directory"
                    }
                  }
                ],
                "imagePullSecrets": [
                  {
                    "name": "nebius-cr"
                  }
                ]
              }
            },
            "runtimeVersionOverride": "1.6.0"
          },
          {
            "name": "nodes",
            "type": "worker",
            "replicas": 2,
            "podTemplate": {
              "spec": {
                "securityContext": {
                  "runAsNonRoot": true,
                  "supplementalGroups": [
                    64000
                  ],
                  "runAsUser": 1000
                },
                "containers": [
                  {
                    "name": "main",
                    "image": "cr.eu-north1.nebius.cloud/<registry>/everserve-engine:dev-e56d9bd",
                    "command": [
                      "python3",
                      "-m",
                      "everserve_vllm.node_main"
                    ],
                    "args": [
                      "--engine",
                      "proof",
                      "--node",
                      "$(EVERSERVE_NODE)",
                      "--slot",
                      "$(GROVE_PCLQ_POD_INDEX)",
                      "--nnodes",
                      "2",
                      "--master-addr",
                      "proof-rendezvous.serving.svc",
                      "--master-port",
                      "29500",
                      "--health-port",
                      "8090",
                      "--leave-within-s",
                      "60",
                      "--model",
                      "Qwen/Qwen2.5-0.5B-Instruct",
                      "--tensor-parallel-size",
                      "1",
                      "--pipeline-parallel-size",
                      "2",
                      "--max-model-len",
                      "8192",
                      "--gpu-memory-utilization",
                      "0.8",
                      "--num-gpu-blocks-override",
                      "4096",
                      "--block-size",
                      "16",
                      "--additional-config",
                      "{\"consolidator_endpoints\":null}"
                    ],
                    "env": [
                      {
                        "name": "EVERSERVE_GRAPH_SAFE",
                        "value": "1"
                      },
                      {
                        "name": "EVERSERVE_ENGINE",
                        "value": "proof"
                      },
                      {
                        "name": "EVERSERVE_GUARANTEE",
                        "value": "continuous"
                      },
                      {
                        "name": "EVERSERVE_DAEMON_SOCKET",
                        "value": "/run/everserve/node.sock"
                      },
                      {
                        "name": "EVERSERVE_SHM_DIR",
                        "value": "/dev/shm/everserve"
                      },
                      {
                        "name": "VLLM_CACHE_ROOT",
                        "value": "/var/lib/everserve/vllm-cache"
                      },
                      {
                        "name": "EVERSERVE_HOST_IP",
                        "valueFrom": {
                          "fieldRef": {
                            "fieldPath": "status.podIP"
                          }
                        }
                      },
                      {
                        "name": "EVERSERVE_NODE",
                        "valueFrom": {
                          "fieldRef": {
                            "fieldPath": "spec.nodeName"
                          }
                        }
                      }
                    ],
                    "volumeMounts": [
                      {
                        "name": "everserve-daemon",
                        "mountPath": "/run/everserve"
                      },
                      {
                        "name": "everserve-shm",
                        "mountPath": "/dev/shm/everserve"
                      },
                      {
                        "name": "everserve-compile-cache",
                        "mountPath": "/var/lib/everserve/vllm-cache"
                      }
                    ],
                    "resources": {
                      "limits": {
                        "nvidia.com/gpu": "1"
                      }
                    },
                    "startupProbe": {
                      "httpGet": {
                        "path": "/live",
                        "port": 8090
                      },
                      "periodSeconds": 10,
                      "failureThreshold": 360
                    },
                    "livenessProbe": {
                      "httpGet": {
                        "path": "/live",
                        "port": 8090
                      },
                      "periodSeconds": 10,
                      "failureThreshold": 3
                    },
                    "readinessProbe": {
                      "httpGet": {
                        "path": "/ready",
                        "port": 8090
                      },
                      "periodSeconds": 5
                    }
                  }
                ],
                "volumes": [
                  {
                    "name": "everserve-daemon",
                    "hostPath": {
                      "path": "/run/everserve",
                      "type": "Directory"
                    }
                  },
                  {
                    "name": "everserve-shm",
                    "hostPath": {
                      "path": "/dev/shm/everserve",
                      "type": "Directory"
                    }
                  },
                  {
                    "name": "everserve-compile-cache",
                    "hostPath": {
                      "path": "/var/lib/everserve/vllm-cache",
                      "type": "Directory"
                    }
                  }
                ],
                "imagePullSecrets": [
                  {
                    "name": "nebius-cr"
                  }
                ],
                "terminationGracePeriodSeconds": 90
              }
            },
            "runtimeVersionOverride": "1.6.0"
          }
        ]
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "proof-rendezvous",
        "namespace": "serving",
        "labels": {
          "nvidia.com/dynamo-graph-deployment-name": "proof",
          "nvidia.com/dynamo-component": "head"
        }
      },
      "spec": {
        "clusterIP": "None",
        "publishNotReadyAddresses": true,
        "selector": {
          "nvidia.com/dynamo-graph-deployment-name": "proof",
          "nvidia.com/dynamo-component": "head"
        },
        "ports": [
          {
            "name": "rendezvous",
            "port": 29500
          }
        ]
      }
    },
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "NetworkPolicy",
      "metadata": {
        "name": "proof-engine",
        "namespace": "serving"
      },
      "spec": {
        "podSelector": {
          "matchLabels": {
            "nvidia.com/dynamo-graph-deployment-name": "proof"
          },
          "matchExpressions": [
            {
              "key": "nvidia.com/dynamo-component",
              "operator": "In",
              "values": [
                "head",
                "nodes"
              ]
            }
          ]
        },
        "policyTypes": [
          "Ingress"
        ],
        "ingress": [
          {
            "from": [
              {
                "podSelector": {
                  "matchLabels": {
                    "nvidia.com/dynamo-graph-deployment-name": "proof"
                  }
                }
              }
            ]
          }
        ]
      }
    }
  ]
}
