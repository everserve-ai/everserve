{
  "version": "two-node-managed-1",
  "outcomesInOrder": [
    "OUTCOME_REPLACE",
    "OUTCOME_REBUILD"
  ],
  "spares": {
    "perEngine": 4,
    "loading": "LOADING_PRELOADED",
    "allowMismatched": false,
    "maxDegradePercent": 0
  },
  "maxConcurrentLosses": 4,
  "noticeMinMs": 2000,
  "engines": [
    {
      "name": "k3-a",
      "members": [
        {
          "node": "node-a",
          "device": 0
        },
        {
          "node": "node-a",
          "device": 1
        },
        {
          "node": "node-a",
          "device": 2
        },
        {
          "node": "node-a",
          "device": 3
        },
        {
          "node": "node-b",
          "device": 0
        },
        {
          "node": "node-b",
          "device": 1
        },
        {
          "node": "node-b",
          "device": 2
        },
        {
          "node": "node-b",
          "device": 3
        }
      ],
      "tensorParallel": 4,
      "expertParallel": 1,
      "pipelineParallel": 2,
      "placementIndependentModel": false,
      "spareNodes": [
        "node-c"
      ],
      "spares": [
        {
          "node": "node-c",
          "device": 0,
          "rank": 4
        },
        {
          "node": "node-c",
          "device": 1,
          "rank": 5
        },
        {
          "node": "node-c",
          "device": 2,
          "rank": 6
        },
        {
          "node": "node-c",
          "device": 3,
          "rank": 7
        }
      ],
      "spareLaunch": {
        "command": [
          "sh",
          "-c",
          "exec sleep 3600"
        ],
        "env": {
          "EVERSERVE_ENGINE": "{engine}",
          "EVERSERVE_SPARE_RANK": "{rank}",
          "CUDA_VISIBLE_DEVICES": "{device}",
          "EVERSERVE_SOCKET": "{socket}"
        }
      },
      "releaseBoundMs": 10000,
      "replicaNodes": [
        "node-c"
      ]
    }
  ]
}
