# The node daemon's settings (/etc/everserve/node.env). Every variable is a flag of
# `everserve-controller node`; `--help` documents them.

# This node's name, as the policy names it. Unset: the hostname.
EVERSERVE_NODE=node-a
# The coordinator, host:port under TLS, and the name on its certificate.
EVERSERVE_COORDINATOR=coordinator.example.internal:7000
# Or follow the coordinator lease instead (decision 0036): its record names the coordinator to
# link to and the term that fences every other. The coordinators' EVERSERVE_LEASE: a file they and
# this node share, or etcd://host:port[,host:port...]/key with the EVERSERVE_ETCD_* TLS settings.
#EVERSERVE_LEASE_WATCH=/var/lib/everserve/coord.lease
#EVERSERVE_ETCD_CA=/etc/everserve/certs/etcd-ca.crt
EVERSERVE_COORDINATOR_NAME=coordinator
# The Unix socket the engine's workers register through.
EVERSERVE_SOCKET=/run/everserve/node.sock
# Where the daemon publishes its record for the workers (file discovery).
EVERSERVE_DISCOVERY_DIR=/run/everserve/discovery
# This node's store, and the address other stores replicate into it through (the store's
# EVERSERVE_STORE_REPLICA_LISTEN as the other nodes reach it). Unset the second on a node that
# takes no replicas.
EVERSERVE_MIRROR_SOCKET=/run/everserve/mirror.sock
EVERSERVE_MIRROR_REPLICA=node-a.example.internal:7001
EVERSERVE_METRICS_ADDR=0.0.0.0:9108
# The address other nodes reach this node at (the fabric's), published in the daemon's record for
# the workers' rendezvous across nodes. Unset on a single node.
EVERSERVE_ADVERTISE_HOST=node-a.example.internal
# Milliseconds between heartbeats to the coordinator; 0 sends none.
EVERSERVE_HEARTBEAT_MS=500
# Where this node learns it is leaving: none, aws, gcp, azure or kubernetes.
EVERSERVE_NOTICE_SOURCE=none
# This node's certificate and key (shared with the store), and the deployment's CA.
EVERSERVE_TLS_CERT=/etc/everserve/certs/node.crt
EVERSERVE_TLS_KEY=/etc/everserve/certs/node.key
EVERSERVE_TLS_CA=/etc/everserve/certs/ca.crt
EVERSERVE_GRACEFUL_SHUTDOWN_SECS=30
EVERSERVE_LOG=info
