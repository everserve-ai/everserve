# The store's settings (/etc/everserve/store.env). Every variable is a flag of `everserve-store`.

# The Unix socket the workers and the daemon reach the store through.
EVERSERVE_STORE_SOCKET=/run/everserve/mirror.sock
# Where the tables live: shared memory, which the workers map (decision 0011).
EVERSERVE_STORE_DATA_DIR=/dev/shm/everserve
# Slot ids per layer table: the engine's KV blocks times its block size.
EVERSERVE_STORE_SLOTS=65536
# Memory budget for the tables, in bytes; a registration past it is refused.
EVERSERVE_STORE_BUDGET_BYTES=137438953472
EVERSERVE_STORE_METRICS_ADDR=0.0.0.0:9109
# Where other nodes' stores replicate into this one (host:port under TLS). Unset on a node that
# takes no replicas; set on every spare node.
EVERSERVE_STORE_REPLICA_LISTEN=0.0.0.0:7001
# The name on peer stores' certificates (every node's certificate from `certs` carries it).
EVERSERVE_STORE_PEER_NAME=store
# This node's certificate and key (shared with the daemon), and the deployment's CA.
EVERSERVE_TLS_CERT=/etc/everserve/certs/node.crt
EVERSERVE_TLS_KEY=/etc/everserve/certs/node.key
EVERSERVE_TLS_CA=/etc/everserve/certs/ca.crt
EVERSERVE_LOG=info

# Bytes each replication target's queue may hold before a commit waits for room; the table
# budget unless given. A replica that cannot keep up slows the engine rather than losing a step.
# EVERSERVE_STORE_REPLICATION_QUEUE_BYTES=

# Seconds a replication carrier waits for a replica's reply before reconnecting; 30 unless given.
# EVERSERVE_STORE_REPLICATION_REPLY_TIMEOUT_S=
