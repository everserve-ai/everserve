# The coordinator's settings (/etc/everserve/coord.env). One line per variable, no quotes.
# Every variable is a flag of `everserve-controller coord`; `--help` documents them.

# The policy document (protobuf JSON): engines, members by node, spare nodes, outcomes.
EVERSERVE_POLICY=/etc/everserve/policy.json
# Where daemons reach the coordinator: host:port under TLS (or unix:/run/everserve/coord.sock on
# a single node, with no TLS variables).
EVERSERVE_LISTEN=0.0.0.0:7000
# The lease; a second coordinator pointed at the same lease stands by. A file for one host, etcd
# for a standby on another host (etcd://10.0.0.5:2379,10.0.0.6:2379,10.0.0.7:2379/everserve/coordinator),
# or a Kubernetes Lease (kubernetes://everserve/coordinator, with EVERSERVE_KUBERNETES_*).
EVERSERVE_LEASE=/var/lib/everserve/coord.lease
# Seconds an etcd lease outlives its holder's last renewal: the longest a standby waits after the
# holder dies. The holder stops acting at three quarters of it.
#EVERSERVE_LEASE_TTL_SECS=10
# TLS to etcd: the CA that signed its server certificates, and a client certificate and key if
# the cluster requires them.
#EVERSERVE_ETCD_CA=/etc/everserve/certs/etcd-ca.crt
#EVERSERVE_ETCD_CERT=/etc/everserve/certs/etcd-client.crt
#EVERSERVE_ETCD_KEY=/etc/everserve/certs/etcd-client.key
# Where daemons link to this coordinator, published in the lease's record for daemons that follow
# it (decision 0036). Unset: the listen address.
#EVERSERVE_ADVERTISE=10.0.0.10:7000
# What the operator asked of each node (cordoned, drained by), kept across a restart. Unset, it
# is kept in memory and a restart forgets it.
EVERSERVE_SPEC_STORE=/var/lib/everserve/specs.pb
# /metrics and /healthz.
EVERSERVE_METRICS_ADDR=0.0.0.0:9107
# The operator API (/v1/engines, /v1/nodes, /v1/pools, decision 0042), under TLS with this
# coordinator's certificate (decision 0039). Its callers present certificates from
# `everserve-controller certs --operator <name>`: operators may write, viewers may read.
EVERSERVE_API_ADDR=0.0.0.0:7443
EVERSERVE_API_OPERATORS=ops
#EVERSERVE_API_VIEWERS=monitoring
# This process's certificate, its key, and the CA every daemon's certificate chains to.
EVERSERVE_TLS_CERT=/etc/everserve/certs/coordinator.crt
EVERSERVE_TLS_KEY=/etc/everserve/certs/coordinator.key
EVERSERVE_TLS_CA=/etc/everserve/certs/ca.crt
# Missed heartbeats after which a daemon's node is lost and its ranks changed (decision 0023);
# with the daemons' 500 ms heartbeat, 3 is 1.5 s. Raise it on a fabric that drops packets.
EVERSERVE_NODE_LOSS_MISSES=3
# Seconds in-flight changes get after SIGTERM before the process exits anyway.
EVERSERVE_GRACEFUL_SHUTDOWN_SECS=30
EVERSERVE_LOG=info
